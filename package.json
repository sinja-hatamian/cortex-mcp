{
  "name": "cortex-mcp-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server for evidence-backed claim verification and decision reviews.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cortex-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "benchmark": "node scripts/benchmark.mjs",
    "smoke:auth": "node examples/authentication-verification.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
